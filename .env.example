# 音乐 API 地址：推荐指向本机/局域网里的 juneix 音乐服务
MUSIC_API_BASE_URL=http://192.168.1.10:8848

# 如果必须走绿联隧道（需要登录态），改成隧道地址并配置 Cookie
# MUSIC_API_BASE_URL=https://app-8848-4096.cn22.ugdocker.link

# 上游需要登录态时按需启用
MUSIC_API_COOKIE=
MUSIC_API_BEARER_TOKEN=

# 独立 agent 镜像的宿主机端口
AGENT_HOST_PORT=8080

# host 网络方案：音乐服务端口（agent 按 127.0.0.1:<该端口> 调用）
MUSIC_KIT_PORT=8848
# host 网络方案：agent 容器内监听端口
AGENT_PORT=8080

# bundle 方案的宿主机端口
MUSIC_KIT_HOST_PORT=8848

# 音乐下载目录（host / bundle 方案）
MUSIC_DIR=./music

MUSIC_API_TIMEOUT=30
MUSIC_API_RETRIES=2
# 上游额度约 5 分钟 50 次；默认 40 次 / 300 秒，给重试留余量
MUSIC_API_RATE_LIMIT=40
MUSIC_API_RATE_WINDOW=300
TZ=Asia/Shanghai
