# 音乐 API 地址：推荐指向本机/局域网里的 juneix 音乐服务
MUSIC_API_BASE_URL=http://192.168.1.10:8848

# 如果必须走绿联隧道（需要登录态），改成隧道地址并配置 Cookie
# MUSIC_API_BASE_URL=https://app-8848-4096.cn22.ugdocker.link

# 上游需要登录态时按需启用
MUSIC_API_COOKIE=
MUSIC_API_BEARER_TOKEN=

# 独立 agent 镜像的宿主机端口
AGENT_HOST_PORT=8080

# host 网络方案：音乐服务端口（agent 按 127.0.0.1:<该端口> 调用）
MUSIC_KIT_PORT=8848
# host 网络方案：agent 容器内监听端口
AGENT_PORT=8080

# bundle 方案的宿主机端口
MUSIC_KIT_HOST_PORT=8848

# 宿主机目录
# MUSIC_DIR：清洗后的媒体库，挂载为容器内 /music，Navidrome 扫描这里
MUSIC_DIR=./music
# DOWNLOADS_DIR：juneix 原始下载目录，挂载为容器内 /downloads
DOWNLOADS_DIR=./downloads

MUSIC_API_TIMEOUT=30
MUSIC_API_DOWNLOAD_TIMEOUT=300
MUSIC_API_RETRIES=2
# 上游额度约 5 分钟 50 次；默认 40 次 / 300 秒，给重试留余量
MUSIC_API_RATE_LIMIT=40
MUSIC_API_RATE_WINDOW=300

# 自动补歌匹配
MATCH_SOURCE=netease
MATCH_THRESHOLD=0.9

# 歌单导入
PLAYLIST_MATCH_THRESHOLD=0.86
# Spotify / 汽水需要代理时填写；请求里 proxy=true 才会使用
IMPORT_PROXY_URL=
# Spotify embed 失败时的 Web API 回退凭据（可选）
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Navidrome（startScan 需要管理员账号）
# host 网络可填 http://127.0.0.1:4533
# bundle 是桥接网络，127.0.0.1 指向容器自身，需要填 NAS 的局域网地址
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=
NAVIDROME_SCAN_WAIT=true

TZ=Asia/Shanghai
